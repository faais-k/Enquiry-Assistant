# ============================================================
# Enquiry Assistant — Environment Variables
# ============================================================
# Copy this file to the appropriate location and fill in your values.
# NEVER commit .env files with real secrets.

# === Frontend (copy to enquiry-frontend/.env) ===
VITE_N8N_BASE_URL=https://your-n8n-instance.app.n8n.cloud

# === n8n Workflow Secrets (configure inside n8n credentials UI) ===
# These are NOT read from .env — they are set inside n8n itself.
# Listed here for documentation only.
GEMINI_API_KEY_EXTRACT=your_gemini_api_key_for_extraction
GEMINI_API_KEY_REPLY=your_gemini_api_key_for_reply
MONGODB_CONNECTION_STRING=your_mongodb_connection_string
